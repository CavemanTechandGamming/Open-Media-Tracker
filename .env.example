# =============================================================================
# Open Media Tracker — copy to `.env` and fill in values
# Docker Compose loads `.env` automatically; keys match SQLite Config overrides.
# =============================================================================

# -----------------------------------------------------------------------------
# HTTP (Docker / reverse proxies)
# -----------------------------------------------------------------------------
# Avoid colliding with Plex (32400), Jellyfin (8096), Pi-hole web, etc.
APP_PORT=8383
# Printed in container logs as http://APP_PUBLIC_HOST:APP_PORT — set to your LAN IP if desired
APP_PUBLIC_HOST=localhost

# -----------------------------------------------------------------------------
# Persistent app data (Docker)
# -----------------------------------------------------------------------------
# Inside the container Compose sets CONFIG_PATH=/config and mounts a named volume there.
# SQLite: /config/open_media_tracker.db — thumbnails: /config/cache/posters/
# Logs directory (created on startup): /config/logs/
# Leave unset for local dev (defaults to ./data/ next to the app).
CONFIG_PATH=

# Host directories for docker-compose.yml (bind-mount sources — MUST be set for Compose)
TV_PATH=
MOVIE_PATH=

# -----------------------------------------------------------------------------
# TMDB (required: set at least ONE of the two below — startup logs an error if both are empty)
# Dashboard: https://www.themoviedb.org/settings/api
# -----------------------------------------------------------------------------
# Preferred: "API Read Access Token" (Bearer auth). If both token and API key are set,
# the app uses the read access token.
TMDB_READ_ACCESS_TOKEN=

# Alternative: classic v3 "API Key (v3 auth)" — sent as query parameter `api_key`.
TMDB_API_KEY=

# -----------------------------------------------------------------------------
# TVDB v4 (required for startup — used for TV series status cross-check)
# Dashboard: https://thetvdb.com/dashboard/account/apikey
# -----------------------------------------------------------------------------
TVDB_API_KEY=

# Only if TVDB instructs you to use a subscriber PIN with login (many setups omit this).
TVDB_PIN=

# -----------------------------------------------------------------------------
# Libraries — each immediate subfolder is one show or movie
# -----------------------------------------------------------------------------
# docker-compose.yml pins these inside the container to /media/tv and /media/movies.
# For bare-metal dev, set host paths here instead.
LIBRARY_TV_PATH=
LIBRARY_MOVIES_PATH=

# -----------------------------------------------------------------------------
# Scheduler & database
# -----------------------------------------------------------------------------
# Background shallow scan interval (minutes); minimum enforced in app: 15
SCAN_INTERVAL_MINUTES=360

# Optional explicit SQLite path (overrides CONFIG_PATH default). Usually leave empty in Docker.
DATABASE_PATH=
